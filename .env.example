# ArthVeda · Private Office — Wealth Projection Studio
#
# This is a fully client-side application. The projection engine requires NO
# backend and NO API keys; all calculations run locally in the browser and
# scenarios are shared via compact, self-contained URLs.
#
# The only optional configuration is analytics. Copy this file to `.env`
# (or `.env.local`) and set the values below if you want to enable it.

# ---------------------------------------------------------------------------
# Google Analytics 4 (optional)
# ---------------------------------------------------------------------------
# Your GA4 Measurement ID, in the form "G-XXXXXXXXXX".
#
# Leave this blank / unset to keep analytics completely OFF: no gtag.js is
# loaded, no cookies are set, and no requests are made. Tracking only starts
# once a valid ID is configured.
VITE_GA4_MEASUREMENT_ID=

# Default analytics consent: "denied" (recommended, GDPR-friendly) or
# "granted". When "denied", GA4 runs in Consent Mode v2 cookieless mode until
# the visitor explicitly grants consent. Defaults to "denied" when unset.
VITE_GA4_DEFAULT_CONSENT=denied
