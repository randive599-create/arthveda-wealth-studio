# Production environment configuration (loaded by `vite build`).
#
# Values here are embedded into the production client bundle. The GA4
# Measurement ID is public (it appears in the gtag.js request either way), so it
# is safe to commit. Local development (`npm run dev`) and tests do NOT load
# this file, so they remain completely tracking-free.

# ---------------------------------------------------------------------------
# Google Analytics 4
# ---------------------------------------------------------------------------
# GA4 Measurement ID for arthvedawealth.in. Consumed by src/analytics/ga4.ts,
# which loads the official gtag.js exactly once (Consent Mode v2 aware).
VITE_GA4_MEASUREMENT_ID=G-03K6CD5EF0

# Default analytics consent. "denied" (GDPR-friendly) keeps GA4 in Consent
# Mode v2 cookieless mode until consent is granted; set to "granted" to enable
# standard cookie-based analytics by default.
VITE_GA4_DEFAULT_CONSENT=denied
